INSTALL EXTENSION vsql_ai;
SELECT prompt('openai', 'gpt-4o-mini', 'invalid_key_12345', 'Hello');
prompt('openai', 'gpt-4o-mini', 'invalid_key_12345', 'Hello')
NULL
Warnings:
Warning	3200	VDF error in function 'prompt': Incorrect API key provided: invalid_*****2345. You can find your API key at https://platform.openai.com/account/api-keys.
SHOW WARNINGS;
Level	Code	Message
Warning	3200	VDF error in function 'prompt': Incorrect API key provided: invalid_*****2345. You can find your API key at https://platform.openai.com/account/api-keys.
# Testing with real OpenAI API key (key hidden from output)
SELECT prompt('openai', 'gpt-4o-mini', @api_key, 'Say only the word: SUCCESS') LIKE '%SUCCESS%' AS contains_success;
contains_success
1
SELECT LENGTH(prompt('openai', 'gpt-4o-mini', @api_key, 'Reply with just: OK')) > 0 AS got_response;
got_response
1
UNINSTALL EXTENSION vsql_ai;
