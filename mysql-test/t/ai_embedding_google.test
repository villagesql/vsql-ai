# Test Google embeddings (gemini-embedding-001 model) for vsql_ai extension

if (!$GEMINI_API_KEY) {
  skip Requires GEMINI_API_KEY environment variable;
}

--source ../include/keyring_setup.inc
INSTALL EXTENSION vsql_ai;

# Store the API key in the keyring. A key stored with keyring_key_store() is
# owned by the account that stored it. The statement carries the key, so it
# is kept out of the result file and, with sql_log_off, out of the general
# query log that MTR enables.
--disable_query_log
--disable_result_log
SET SESSION sql_log_off = ON;
--eval SELECT keyring_key_store('test_google_key', 'SECRET', '$GEMINI_API_KEY')
SET SESSION sql_log_off = OFF;
--enable_result_log
--enable_query_log
SELECT keyring_key_store('test_invalid_key', 'SECRET', 'invalid_key_12345');

SET GLOBAL vsql_ai.models = '{
  "live":    {"provider": "google", "model": "gemini-embedding-001",
              "key_id": "test_google_key", "key_owner": "root@localhost"},
  "bad_key": {"provider": "google", "model": "gemini-embedding-001",
              "key_id": "test_invalid_key", "key_owner": "root@localhost"}
}';

# Test with invalid API key - should produce a warning
SELECT ai_embedding('bad_key', 'Hello');
SHOW WARNINGS;

--echo # Running live API test

--disable_query_log
SET @embedding = ai_embedding('live', 'Hello world');
--enable_query_log

# Verify we got a JSON array back (starts with [ and ends with ])
SELECT @embedding LIKE '[%' AND @embedding LIKE '%]' AS is_json_array;

# Verify the embedding is not empty
SELECT LENGTH(@embedding) > 10 AS got_embedding;

# Verify we can create embeddings for different text
--disable_query_log
SET @embedding2 = ai_embedding('live', 'Machine learning');
--enable_query_log

SELECT LENGTH(@embedding2) > 10 AS got_second_embedding;

# ai_embedding_binary(): the same embedding as packed little-endian float32,
# four bytes per dimension
SET @json = ai_embedding('live', 'Hello world');
SET @bin = ai_embedding_binary('live', 'Hello world');
SELECT LENGTH(@bin) = 4 * JSON_LENGTH(@json) AS four_bytes_per_dimension,
       CHARSET(@bin) AS charset;

# Cleanup
SET GLOBAL vsql_ai.models = DEFAULT;
SELECT keyring_key_remove('test_google_key');
SELECT keyring_key_remove('test_invalid_key');
UNINSTALL EXTENSION vsql_ai;
--source ../include/keyring_teardown.inc
