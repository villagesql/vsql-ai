# Test Google embeddings (gemini-embedding-001 model) for vsql_ai extension

if (!$GEMINI_API_KEY) {
  skip Requires GEMINI_API_KEY environment variable;
}

# Install extension
INSTALL EXTENSION vsql_ai;

# Test with invalid API key - should produce a warning
SELECT ai_embedding('google', 'gemini-embedding-001', 'invalid_key_12345', 'Hello');
SHOW WARNINGS;

--echo # Running live API test

# Hide the API key from the result file
--disable_query_log
--eval SET @api_key = '$GEMINI_API_KEY'
--enable_query_log

# Create embedding for simple text
--disable_query_log
SET @embedding = ai_embedding('google', 'gemini-embedding-001', @api_key, 'Hello world');
--enable_query_log

# Verify we got a JSON array back (starts with [ and ends with ])
SELECT @embedding LIKE '[%' AND @embedding LIKE '%]' AS is_json_array;

# Verify the embedding is not empty
SELECT LENGTH(@embedding) > 10 AS got_embedding;

# Verify we can create embeddings for different text
--disable_query_log
SET @embedding2 = ai_embedding('google', 'gemini-embedding-001', @api_key, 'Machine learning');
--enable_query_log

SELECT LENGTH(@embedding2) > 10 AS got_second_embedding;

# Cleanup
UNINSTALL EXTENSION vsql_ai;
