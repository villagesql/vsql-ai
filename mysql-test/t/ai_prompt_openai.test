# Test OpenAI provider (GPT models) for vsql_ai extension

if (!$OPENAI_API_KEY) {
  skip Requires OPENAI_API_KEY environment variable;
}

--source ../include/keyring_setup.inc
INSTALL EXTENSION vsql_ai;

# Store the API key in the keyring. A key stored with keyring_key_store() is
# owned by the account that stored it. The statement carries the key, so it
# is kept out of the result file and, with sql_log_off, out of the general
# query log that MTR enables.
--disable_query_log
--disable_result_log
SET SESSION sql_log_off = ON;
--eval SELECT keyring_key_store('test_openai_key', 'SECRET', '$OPENAI_API_KEY')
SET SESSION sql_log_off = OFF;
--enable_result_log
--enable_query_log
SELECT keyring_key_store('test_invalid_key', 'SECRET', 'invalid_key_12345');

SET GLOBAL vsql_ai.models = '{
  "live":    {"provider": "openai", "model": "gpt-6-luna",
              "key_id": "test_openai_key", "key_owner": "root@localhost"},
  "bad_key": {"provider": "openai", "model": "gpt-6-luna",
              "key_id": "test_invalid_key", "key_owner": "root@localhost"}
}';

# Test with invalid API key - should produce a warning
SELECT ai_prompt('bad_key', 'Hello');
SHOW WARNINGS;

--echo # Running live API test

# Simple prompt test - the model should respond with SUCCESS
SELECT ai_prompt('live', 'Say only the word: SUCCESS') LIKE '%SUCCESS%' AS contains_success;

# Verify we got a non-empty response
SELECT LENGTH(ai_prompt('live', 'Reply with just: OK')) > 0 AS got_response;

# Cleanup
SET GLOBAL vsql_ai.models = DEFAULT;
SELECT keyring_key_remove('test_openai_key');
SELECT keyring_key_remove('test_invalid_key');
UNINSTALL EXTENSION vsql_ai;
--source ../include/keyring_teardown.inc
