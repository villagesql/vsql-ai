# Test local provider (Ollama) embeddings for vsql_ai extension

if (!$OLLAMA_EMBED_MODEL) {
  skip Requires OLLAMA_EMBED_MODEL environment variable;
}

# Install extension
INSTALL EXTENSION vsql_ai;

# A model that has not been pulled produces a warning and NULL.
# Ollama's wording differs between versions, so keep only the model name.
--replace_regex /: model .*/: model no-such-model-vsql-test not found/
SELECT ai_embedding('local', 'no-such-model-vsql-test', '', 'Hello');
--replace_regex /: model .*/: model no-such-model-vsql-test not found/
SHOW WARNINGS;

--echo # Running live API test

--disable_query_log
--eval SET @model = '$OLLAMA_EMBED_MODEL'
--enable_query_log

# Create embedding for simple text
--disable_query_log
SET @embedding = ai_embedding('local', @model, '', 'Hello world');
--enable_query_log

# Verify we got a JSON array back (starts with [ and ends with ])
SELECT @embedding LIKE '[%' AND @embedding LIKE '%]' AS is_json_array;

# Verify the embedding is not empty
SELECT LENGTH(@embedding) > 10 AS got_embedding;

# Verify we can create embeddings for different text
--disable_query_log
SET @embedding2 = ai_embedding('local', @model, '', 'Machine learning');
--enable_query_log

SELECT LENGTH(@embedding2) > 10 AS got_second_embedding;

# Cleanup
UNINSTALL EXTENSION vsql_ai;
