# Test Anthropic provider for vsql_ai extension

# Skip if ANTHROPIC_API_KEY is not set
if (!$ANTHROPIC_API_KEY) {
  skip Requires ANTHROPIC_API_KEY environment variable;
}

--source ../include/keyring_setup.inc
INSTALL EXTENSION vsql_ai;

# Store the API key in the keyring. A key stored with keyring_key_store() is
# owned by the account that stored it. The statement carries the key, so it
# is kept out of the result file and, with sql_log_off, out of the general
# query log that MTR enables.
--disable_query_log
--disable_result_log
SET SESSION sql_log_off = ON;
--eval SELECT keyring_key_store('test_anthropic_key', 'SECRET', '$ANTHROPIC_API_KEY')
SET SESSION sql_log_off = OFF;
--enable_result_log
--enable_query_log
SELECT keyring_key_store('test_invalid_key', 'SECRET', 'invalid_key_12345');

SET GLOBAL vsql_ai.models = '{
  "sonnet":  {"provider": "anthropic", "model": "claude-sonnet-5-5",
              "key_id": "test_anthropic_key", "key_owner": "root@localhost"},
  "fable":   {"provider": "anthropic", "model": "claude-fable-5-2",
              "key_id": "test_anthropic_key", "key_owner": "root@localhost"},
  "bad_key": {"provider": "anthropic", "model": "claude-sonnet-5-5",
              "key_id": "test_invalid_key", "key_owner": "root@localhost"}
}';

# Test with invalid API key - should produce a warning
SELECT ai_prompt('bad_key', 'Hello');
SHOW WARNINGS;

--echo # Running live API test

# Simple prompt test - Claude should respond with SUCCESS
SELECT ai_prompt('sonnet', 'Say only the word: SUCCESS') LIKE '%SUCCESS%' AS contains_success;

# Verify we got a non-empty response
SELECT LENGTH(ai_prompt('sonnet', 'Reply with just: OK')) > 0 AS got_response;

# Extended thinking model test - claude-fable-5-2 returns a "thinking" content
# block before the "text" block; verify the text is still extracted
SELECT ai_prompt('fable', 'Say only the word: SUCCESS') LIKE '%SUCCESS%' AS fable_contains_success;

# Cleanup
SET GLOBAL vsql_ai.models = DEFAULT;
SELECT keyring_key_remove('test_anthropic_key');
SELECT keyring_key_remove('test_invalid_key');
UNINSTALL EXTENSION vsql_ai;
--source ../include/keyring_teardown.inc
