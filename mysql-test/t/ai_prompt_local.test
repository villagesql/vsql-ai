# Test local provider (Ollama) for vsql_ai extension

# Skip if OLLAMA_MODEL is not set
if (!$OLLAMA_MODEL) {
  skip Requires OLLAMA_MODEL environment variable;
}

# Install extension
INSTALL EXTENSION vsql_ai;
# Calling the functions needs the VSQL_AI_USER privilege
GRANT VSQL_AI_USER ON *.* TO root@localhost;

# The local provider needs no API key, so its models need no key_id and no
# keyring. The model name comes from the environment, so it is hidden.
--disable_query_log
--eval SET GLOBAL vsql_ai.models = '{"live": {"provider": "local", "model": "$OLLAMA_MODEL"}, "missing": {"provider": "local", "model": "no-such-model-vsql-test"}}'
--enable_query_log

# A model that has not been pulled produces a warning and NULL.
# Ollama's wording differs between versions, so keep only the model name.
--replace_regex /: model .*/: model no-such-model-vsql-test not found/
SELECT ai_prompt('missing', 'Hello');
--replace_regex /: model .*/: model no-such-model-vsql-test not found/
SHOW WARNINGS;

# Test with real Ollama
--echo # Running live API test

# Simple prompt test - model should respond with SUCCESS
SELECT ai_prompt('live', 'Say only the word: SUCCESS') LIKE '%SUCCESS%' AS contains_success;

# Verify we got a non-empty response
SELECT LENGTH(ai_prompt('live', 'Reply with just: OK')) > 0 AS got_response;

# ai_request(): a native Ollama /api/chat body. Ollama streams unless told
# not to, so "stream": false is added.
SET @response = ai_request('live', '{"messages": [{"role": "user", "content": "Say only the word: SUCCESS"}], "think": false}');
SELECT JSON_VALID(@response) AS valid_json,
       JSON_EXTRACT(@response, '$.done') AS done,
       JSON_UNQUOTE(JSON_EXTRACT(@response, '$.message.content')) LIKE '%SUCCESS%' AS contains_success;

# Cleanup
SET GLOBAL vsql_ai.models = DEFAULT;
REVOKE VSQL_AI_USER ON *.* FROM root@localhost;
UNINSTALL EXTENSION vsql_ai;
