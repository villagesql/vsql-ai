# Test local provider (Ollama) for vsql_ai extension

# Skip if OLLAMA_MODEL is not set
if (!$OLLAMA_MODEL) {
  skip Requires OLLAMA_MODEL environment variable;
}

# Install extension
INSTALL EXTENSION vsql_ai;

# A model that has not been pulled produces a warning and NULL.
# Ollama's wording differs between versions, so keep only the model name.
--replace_regex /: model .*/: model no-such-model-vsql-test not found/
SELECT ai_prompt('local', 'no-such-model-vsql-test', '', 'Hello');
--replace_regex /: model .*/: model no-such-model-vsql-test not found/
SHOW WARNINGS;

# Test with real Ollama
--echo # Running live API test

--disable_query_log
--eval SET @model = '$OLLAMA_MODEL'
--enable_query_log

# Simple prompt test - model should respond with SUCCESS
SELECT ai_prompt('local', @model, '', 'Say only the word: SUCCESS') LIKE '%SUCCESS%' AS contains_success;

# Verify we got a non-empty response
SELECT LENGTH(ai_prompt('local', @model, '', 'Reply with just: OK')) > 0 AS got_response;

# Cleanup
UNINSTALL EXTENSION vsql_ai;
