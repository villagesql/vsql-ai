# Test error handling for vsql_ai extension. Argument and registry
# validation is covered by ai_registry.

# Install extension
INSTALL EXTENSION vsql_ai;

SET GLOBAL vsql_ai.models = '{"local": {"provider": "local", "model": "no-such-model"}}';

# Input that is not valid UTF-8 never reaches the extension: the server
# rejects the conversion to the function's utf8mb4 argument with
# ER_CANNOT_CONVERT_STRING. (A latin1 literal would be converted instead,
# 0xFF becoming a valid "ÿ", so a _binary literal is used.) The extension
# still contains the json::dump() exception itself as defense in depth.
--error 3854
SELECT ai_prompt('local', _binary 0xFF) IS NULL AS invalid_utf8_prompt_is_null;
--error 3854
SELECT ai_embedding('local', _binary 0xFF) IS NULL AS invalid_utf8_embed_is_null;

# Cleanup
SET GLOBAL vsql_ai.models = DEFAULT;
UNINSTALL EXTENSION vsql_ai;
