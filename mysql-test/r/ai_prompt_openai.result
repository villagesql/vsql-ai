SHOW WARNINGS;
Level	Code	Message
Warning	3200	VDF error in function 'ai_prompt': Incorrect API key provided: invalid_*****2345. You can find your API key at https://platform.openai.com/account/api-keys.
# Running live API test
SELECT ai_prompt('live', 'Say only the word: SUCCESS') LIKE '%SUCCESS%' AS contains_success;
contains_success
1
SELECT LENGTH(ai_prompt('live', 'Reply with just: OK')) > 0 AS got_response;
got_response
1
SET @response = ai_request('live', '{"messages": [{"role": "user", "content": "Say only the word: SUCCESS"}]}');
SELECT JSON_VALID(@response) AS valid_json,
JSON_UNQUOTE(JSON_EXTRACT(@response, '$.object')) AS object,
JSON_UNQUOTE(JSON_EXTRACT(@response, '$.choices[0].message.content')) LIKE '%SUCCESS%' AS contains_success;
valid_json	object	contains_success
1	chat.completion	1
SET GLOBAL vsql_ai.models = DEFAULT;
SELECT keyring_key_remove('test_openai_key');
keyring_key_remove('test_openai_key')
1
SELECT keyring_key_remove('test_invalid_key');
keyring_key_remove('test_invalid_key')
1
UNINSTALL EXTENSION vsql_ai;
