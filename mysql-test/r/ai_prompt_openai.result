SELECT STATUS_VALUE AS keyring_status
FROM performance_schema.keyring_component_status
WHERE STATUS_KEY = 'Component_status';
keyring_status
Active
INSTALL EXTENSION vsql_ai;
SELECT keyring_key_store('test_invalid_key', 'SECRET', 'invalid_key_12345');
keyring_key_store('test_invalid_key', 'SECRET', 'invalid_key_12345')
1
SET GLOBAL vsql_ai.models = '{
  "live":    {"provider": "openai", "model": "gpt-6-luna",
              "key_id": "test_openai_key", "key_owner": "root@localhost"},
  "bad_key": {"provider": "openai", "model": "gpt-6-luna",
              "key_id": "test_invalid_key", "key_owner": "root@localhost"}
}';
SELECT ai_prompt('bad_key', 'Hello');
ai_prompt('bad_key', 'Hello')
NULL
