SELECT STATUS_VALUE AS keyring_status
FROM performance_schema.keyring_component_status
WHERE STATUS_KEY = 'Component_status';
keyring_status
Active
INSTALL EXTENSION vsql_ai;
SELECT keyring_key_store('test_invalid_key', 'SECRET', 'invalid_key_12345');
keyring_key_store('test_invalid_key', 'SECRET', 'invalid_key_12345')
1
SET GLOBAL vsql_ai.models = '{
  "live":    {"provider": "google", "model": "gemini-3.5-flash-lite",
              "key_id": "test_google_key", "key_owner": "root@localhost"},
  "bad_key": {"provider": "google", "model": "gemini-3.5-flash-lite",
              "key_id": "test_invalid_key", "key_owner": "root@localhost"}
}';
SELECT ai_prompt('bad_key', 'Hello');
ai_prompt('bad_key', 'Hello')
NULL
Warnings:
Warning	3200	VDF error in function 'ai_prompt': API key not valid. Please pass a valid API key.
SHOW WARNINGS;
Level	Code	Message
Warning	3200	VDF error in function 'ai_prompt': API key not valid. Please pass a valid API key.
# Running live API test
SELECT ai_prompt('live', 'Say only the word: SUCCESS') LIKE '%SUCCESS%' AS contains_success;
contains_success
1
SELECT LENGTH(ai_prompt('live', 'Reply with just: OK')) > 0 AS got_response;
got_response
1
SET @response = ai_request('live', '{"contents": [{"parts": [{"text": "Say only the word: SUCCESS"}]}]}');
SELECT JSON_VALID(@response) AS valid_json,
JSON_EXTRACT(@response, '$.candidates[0].content.parts') LIKE '%SUCCESS%' AS contains_success;
valid_json	contains_success
1	1
SET GLOBAL vsql_ai.models = DEFAULT;
SELECT keyring_key_remove('test_google_key');
keyring_key_remove('test_google_key')
1
SELECT keyring_key_remove('test_invalid_key');
keyring_key_remove('test_invalid_key')
1
UNINSTALL EXTENSION vsql_ai;
