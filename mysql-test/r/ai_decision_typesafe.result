SELECT STATUS_VALUE AS keyring_status
FROM performance_schema.keyring_component_status
WHERE STATUS_KEY = 'Component_status';
keyring_status
Active
INSTALL EXTENSION vsql_ai;
SELECT keyring_key_store('test_invalid_key', 'SECRET', 'invalid_key_12345');
keyring_key_store('test_invalid_key', 'SECRET', 'invalid_key_12345')
1
SET GLOBAL vsql_ai.models = '{
  "live":    {"provider": "typesafe", "model": "jev-latest",
              "key_id": "test_typesafe_key", "key_owner": "root@localhost"},
  "bad_key": {"provider": "typesafe", "model": "jev-latest",
              "key_id": "test_invalid_key", "key_owner": "root@localhost"}
}';
SET @input = 'Subject: URGENT - invoice #4411 charged twice! I was billed 250 dollars twice this morning and need a refund today.';
SET @questions = '{
  "is_billing": {"type": "noul", "instructions": "Is this message about billing?",
                 "criteria": {"true": "About charges, invoices or refunds",
                              "false": "About anything else"}},
  "tone":       {"type": "choice", "instructions": "What is the tone of this message?",
                 "criteria": {"angry": "Upset or hostile", "calm": "Neutral or polite",
                              "excited": "Enthusiastic"}},
  "urgency":    {"type": "score", "instructions": "How urgent is this message?",
                 "criteria": ["Can wait", "Needs attention this week",
                              "Needs attention today"]}
}';
SELECT ai_decision('bad_key', @input, @questions);
ai_decision('bad_key', @input, @questions)
NULL
Warnings:
Warning	3200	VDF error in function 'ai_decision': Cannot authenticate with the server. Please check your API key and try again.
SHOW WARNINGS;
Level	Code	Message
Warning	3200	VDF error in function 'ai_decision': Cannot authenticate with the server. Please check your API key and try again.
# Running live API test
SET @answers = ai_decision('live', @input, @questions);
SELECT JSON_VALID(@answers) AS valid_json;
valid_json
1
SELECT JSON_LENGTH(@answers) AS answer_count;
answer_count
3
SELECT JSON_EXTRACT(@answers, '$.is_billing.type') AS noul_type,
JSON_EXTRACT(@answers, '$.is_billing.noul') > 0.5 AS is_billing;
noul_type	is_billing
"noul"	1
SELECT JSON_EXTRACT(@answers, '$.tone.type') AS choice_type,
JSON_UNQUOTE(JSON_EXTRACT(@answers, '$.tone.choice')) AS tone,
JSON_LENGTH(JSON_EXTRACT(@answers, '$.tone.probabilities')) AS tone_options,
JSON_CONTAINS_PATH(@answers, 'one', '$.tone.confidence') AS tone_has_confidence;
choice_type	tone	tone_options	tone_has_confidence
"choice"	angry	3	1
SELECT JSON_EXTRACT(@answers, '$.urgency.type') AS score_type,
JSON_EXTRACT(@answers, '$.urgency.score') > 1 AS is_urgent,
JSON_LENGTH(JSON_EXTRACT(@answers, '$.urgency.probabilities')) AS urgency_levels,
JSON_UNQUOTE(JSON_EXTRACT(@answers, '$.urgency.legend."2"')) AS top_level;
score_type	is_urgent	urgency_levels	top_level
"score"	1	3	Needs attention today
SELECT JSON_CONTAINS_PATH(@answers, 'one', '$.is_billing.confidence') AS noul_has_confidence;
noul_has_confidence
0
SET @response = ai_request('live', '{"state": "I was billed twice for invoice 4411.", "questions": {"is_billing": {"type": "noul", "instructions": "Is this message about billing?"}}}');
SELECT JSON_VALID(@response) AS valid_json,
JSON_UNQUOTE(JSON_EXTRACT(@response, '$.model')) LIKE 'jev-%' AS versioned_model,
JSON_CONTAINS_PATH(@response, 'one', '$.usage.input_tokens') AS has_usage,
JSON_EXTRACT(@response, '$.answers.is_billing.noul') > 0.5 AS is_billing;
valid_json	versioned_model	has_usage	is_billing
1	1	1	1
SELECT ai_prompt('live', 'Hello') IS NULL AS typesafe_prompt_is_null;
typesafe_prompt_is_null
1
Warnings:
Warning	3200	VDF error in function 'ai_prompt': TypeSafe offers only decisions; use ai_decision()
SELECT ai_embedding('live', 'Hello') IS NULL AS typesafe_embedding_is_null;
typesafe_embedding_is_null
1
Warnings:
Warning	3200	VDF error in function 'ai_embedding': TypeSafe offers only decisions; use ai_decision()
SET GLOBAL vsql_ai.models = DEFAULT;
SELECT keyring_key_remove('test_typesafe_key');
keyring_key_remove('test_typesafe_key')
1
SELECT keyring_key_remove('test_invalid_key');
keyring_key_remove('test_invalid_key')
1
UNINSTALL EXTENSION vsql_ai;
